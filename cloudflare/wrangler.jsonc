// Production Worker. workers.dev is off. No routes and no custom domain.
// A minute cron keeps the single container instance-0 from going idle.
// image is the repository Dockerfile used for the production image.
// Wrangler builds it on deploy. The build context is the repository root.
// Do not set vars. A var with the same name replaces an existing secret.
// SESSION_COOKIE_TRUSTED_URL, NEWAPI_BASE_URL, and GLUE_PUBLIC_URL stay unset here.
// Secrets are Worker secrets and are passed through at start.
// Custom sizes on the default policy need at least 1 vCPU and 3 GiB of memory
// per vCPU, so 512 MiB is not legal. basic is the predefined type at 1 GiB,
// above the current Cloud Run 512 MiB.
// max_instances is set here because the durable_object policy rejects that field.
{
  "name": "needtoken-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "containers": [
    {
      "class_name": "NeedtokenApiContainer",
      "scheduling_policy": "default",
      "image": "../Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 2,
      "constraints": {
        "regions": ["APAC"]
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEEDTOKEN_API",
        "class_name": "NeedtokenApiContainer"
      }
    ]
  },
  "exports": {
    "NeedtokenApiContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
